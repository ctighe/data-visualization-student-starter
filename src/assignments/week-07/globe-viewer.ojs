// https://observablehq.com/@sugarcube/globe is the source for this code

polished = {
  const W = 640, cx = W / 2, cy = W / 2, Rmin = 80, Rmax = W;
  let R = 200;
  const R0 = R;
  const toRad = d => d * Math.PI / 180;
  let rot = { lon: 0, lat: 15 };

  // Population (millions, 2023 est.) by ISO 3166-1 numeric code
  const pop = {4:42,8:2.8,12:45,24:36,32:46,36:26,40:9.1,50:173,56:11.6,
    64:0.8,68:12,70:3.2,72:2.6,76:216,100:6.5,104:55,108:13,112:9.2,116:17,
    120:28,124:39,140:5.6,144:22,148:17,152:19,156:1412,170:52,178:6,180:102,
    188:5.2,191:3.9,192:11,196:1.3,203:10.8,204:13,208:5.9,214:11,218:18,
    222:6.3,226:1.5,231:126,232:3.6,233:1.4,246:5.6,250:68,262:1,266:2.4,
    268:3.7,270:2.4,276:84,288:34,300:10.4,320:18,324:14,328:0.8,332:12,
    340:10,348:9.6,352:0.4,356:1428,360:277,364:88,368:44,372:5.1,376:9.8,
    380:59,384:28,388:2.8,392:125,400:11,404:55,408:26,410:52,414:4.3,
    417:6.7,418:7.5,422:5.3,426:2.3,430:5.3,434:7,440:2.8,442:0.7,450:30,
    454:20,458:34,466:22,478:4.8,484:129,496:3.4,504:37,508:33,512:4.6,
    516:2.6,524:30,528:17.6,540:0.3,548:0.3,554:5.2,558:7,562:26,566:224,
    578:5.5,586:230,591:4.4,598:9.2,600:7,604:34,608:117,616:38,620:10.3,
    634:2.7,642:19,643:144,646:14,682:37,686:17,694:8.6,702:5.6,703:5.5,
    704:99,705:2.1,706:18,710:60,716:16,724:48,729:46,740:0.6,752:10.5,
    756:8.8,760:22,762:10,764:72,768:9,780:1.5,784:10,788:12,792:85,
    800:48,804:37,818:110,826:68,834:65,840:335,854:23,858:3.4,860:36,
    862:28,887:34,894:20};

  // Log color scale
  const colorScale = d3.scaleSequentialLog(d3.interpolateYlOrRd).domain([0.3, 1500]);
  const getColor = f => { const v = pop[+f.id]; return v ? colorScale(v) : "#c4b99a"; };

  function project(lon, lat) {
    const dλ = toRad(lon - rot.lon), φ = toRad(lat), φc = toRad(rot.lat);
    const cosφ = Math.cos(φ), sinφ = Math.sin(φ), cosφc = Math.cos(φc), sinφc = Math.sin(φc);
    let px = R * cosφ * Math.sin(dλ);
    let py = -R * (cosφc * sinφ - sinφc * cosφ * Math.cos(dλ));
    const cosC = sinφc * sinφ + cosφc * cosφ * Math.cos(dλ);
    if (cosC < 0) { const d = Math.hypot(px, py) || 1; const s = (2*R-d)/d; px *= s; py *= s; }
    return [cx + px, cy + py];
  }
  const visible = (lon, lat) => {
    const dλ = toRad(lon - rot.lon), φ = toRad(lat), φc = toRad(rot.lat);
    return Math.sin(φc) * Math.sin(φ) + Math.cos(φc) * Math.cos(φ) * Math.cos(dλ) > 0;
  };
  const polysOf = f => f.geometry.type === "Polygon"
    ? [f.geometry.coordinates] : f.geometry.coordinates;
  const pathOf = f => polysOf(f).flatMap(poly =>
    poly.map(ring => ring.map(([lo, la], i) => {
      const [x, y] = project(lo, la);
      return `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`;
    }).join("") + "Z")
  ).join(" ");

  // Graticule: meridians every 30°, parallels every 30°
  // No visibility check needed — Horizon Overflow pushes back-hemisphere
  // points outside the clip, so the same clip-path handles everything.
  function graticulePath() {
    const parts = [];
    for (let lon = -180; lon < 180; lon += 30) {
      const pts = [];
      for (let lat = -90; lat <= 90; lat += 2) pts.push(project(lon, lat));
      parts.push(pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`).join(""));
    }
    for (let lat = -60; lat <= 60; lat += 30) {
      const pts = [];
      for (let lon = -180; lon <= 180; lon += 2) pts.push(project(lon, lat));
      parts.push(pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`).join(""));
    }
    return parts.join(" ");
  }

  const svg = d3.create("svg").attr("viewBox", [0, 0, W, W])
    .style("width", "100%").style("cursor", "grab").style("user-select", "none")
    .style("background", "#0f172a").style("border-radius", "12px");

  // Defs: clip, ocean gradient, shine gradient, atmospheric glow
  const defs = svg.append("defs");
  defs.append("clipPath").attr("id", "clip2").append("circle").attr("cx", cx).attr("cy", cy).attr("r", R);
  const ocean = defs.append("radialGradient").attr("id", "ocean")
    .attr("cx", "40%").attr("cy", "35%").attr("r", "60%");
  ocean.append("stop").attr("offset", "0%").attr("stop-color", "#60a5fa");
  ocean.append("stop").attr("offset", "100%").attr("stop-color", "#1e40af");
  const shine = defs.append("radialGradient").attr("id", "shine")
    .attr("cx", "35%").attr("cy", "30%").attr("r", "60%");
  shine.append("stop").attr("offset", "0%").attr("stop-color", "white").attr("stop-opacity", 0.15);
  shine.append("stop").attr("offset", "100%").attr("stop-color", "white").attr("stop-opacity", 0);
  const glow = defs.append("filter").attr("id", "glow")
    .attr("x", "-20%").attr("y", "-20%").attr("width", "140%").attr("height", "140%");
  glow.append("feGaussianBlur").attr("in", "SourceGraphic").attr("stdDeviation", 3).attr("result", "blur");
  glow.append("feMerge").selectAll("feMergeNode")
    .data(["blur", "SourceGraphic"]).join("feMergeNode").attr("in", d => d);

  // Layers: ocean → countries (clipped) → graticule (clipped) → glow → shine
  const cOcean = svg.append("circle").attr("cx", cx).attr("cy", cy).attr("r", R).attr("fill", "url(#ocean)");
  const g = svg.append("g").attr("clip-path", "url(#clip2)");
  const gGrat = svg.append("g").attr("clip-path", "url(#clip2)")
    .attr("fill", "none").attr("stroke", "white").attr("stroke-width", 0.5)
    .attr("stroke-opacity", 0.15).style("pointer-events", "none");
  const cGlow = svg.append("circle").attr("cx", cx).attr("cy", cy).attr("r", R)
    .attr("fill", "none").attr("stroke", "#60a5fa").attr("stroke-width", 1.5)
    .attr("stroke-opacity", 0.5).attr("filter", "url(#glow)");
  const cShine = svg.append("circle").attr("cx", cx).attr("cy", cy).attr("r", R)
    .attr("fill", "url(#shine)").style("pointer-events", "none");
  const cClip = defs.select("circle");

  function updateRadius() {
    cClip.attr("r", R); cOcean.attr("r", R); cGlow.attr("r", R); cShine.attr("r", R);
  }

  function render() {
    g.selectAll("*").remove();
    countries.forEach((f) => {
      if (!polysOf(f).some(poly => poly[0].some(c => visible(...c)))) return;
      g.append("path").attr("d", pathOf(f))
        .attr("fill", getColor(f)).attr("stroke", "rgba(255,255,255,0.3)").attr("stroke-width", 0.5);
    });
    gGrat.selectAll("*").remove();
    gGrat.append("path").attr("d", graticulePath());
  }
  render();

  // Legend
  const lw = 160, lh = 8, lx = 20, ly = W - 30;
  const lg = svg.append("g").attr("transform", `translate(${lx},${ly})`);
  const legendScale = d3.scaleLog().domain([0.3, 1500]).range([0, lw]);
  for (let i = 0; i < lw; i++) {
    lg.append("rect").attr("x", i).attr("y", 0).attr("width", 1).attr("height", lh)
      .attr("fill", colorScale(legendScale.invert(i)));
  }
  [1, 10, 100, 1000].forEach(v => {
    lg.append("text").attr("x", legendScale(v)).attr("y", lh + 11)
      .text(v >= 1000 ? v/1000 + "B" : v + "M")
      .attr("fill", "#94a3b8").attr("font-size", 8).attr("text-anchor", "middle")
      .attr("font-family", "sans-serif");
  });
  lg.append("text").attr("x", lw / 2).attr("y", -4)
    .text("Population (2023)")
    .attr("fill", "#94a3b8").attr("font-size", 9).attr("text-anchor", "middle")
    .attr("font-family", "sans-serif");

  // Auto-rotation, drag, zoom
  let dragging = false, autoRotate = true, sx, sy, sr;

  function spin() {
    if (autoRotate && !dragging) {
      rot.lon -= 0.15;
      render();
    }
    requestAnimationFrame(spin);
  }
  spin();

  svg.on("mousedown", e => { dragging = true; autoRotate = false; sx = e.clientX; sy = e.clientY; sr = {...rot}; });
  d3.select(window).on("mousemove.polished", e => {
    if (!dragging) return;
    const k = 0.3 * R0 / R;
    rot.lon = sr.lon - (e.clientX - sx) * k;
    rot.lat = Math.max(-80, Math.min(80, sr.lat + (e.clientY - sy) * k));
    render();
  });
  d3.select(window).on("mouseup.polished", () => { dragging = false; });

  svg.on("wheel", e => {
    e.preventDefault();
    R = Math.max(Rmin, Math.min(Rmax, R - e.deltaY * 0.3));
    updateRadius();
    render();
  }, { passive: false });

  return svg.node();
}